# Copy to .dm.env only if you want optional connections.
# Use the full path of a stable, writable data directory if changing the local default.
# DM_DATA_DIR=/path/to/workspace

# Content analysis + writing model (use a vision-capable model for images/video frames)
# DM_MODEL_BASE_URL=https://provider.example/v1
# DM_MODEL_NAME=your-model
# DM_MODEL_KEY=

# Optional local Apple Silicon engine (local_ai.py on port 8770)
# DM_MODEL_BASE_URL=http://127.0.0.1:8770/v1
# DM_MODEL_NAME=mlx-community/Qwen3-VL-2B-Instruct-4bit
# DM_ASR_BASE_URL=http://127.0.0.1:8770/v1
# DM_ASR_MODEL=mlx-community/whisper-small-mlx
# DM_ANALYSIS_MAX_CHARS=12000
# DM_ANALYSIS_MAX_TOKENS=1200

# Notion
# DM_NOTION_TOKEN=

# Transcription (FFmpeg also required)
# DM_ASR_BASE_URL=https://provider.example/v1
# DM_ASR_MODEL=your-transcription-model
# DM_ASR_KEY=

# PDF OCR (Poppler, Tesseract and the language pack also required)
# DM_OCR_ENABLED=1
# DM_OCR_LANG=chi_sim+eng
# Platform images use Tesseract when installed, or local Apple Vision on macOS via PyObjC (installed by requirements.txt).
# ffmpeg is required for video frames; ffprobe is optional.

# Optional source credential, referenced by name in the source settings
# DM_API_TOKEN_NEWS=
# Optional upstream source hosts (comma-separated); leave unset for public HTTPS only.
# DM_RSS_TRUSTED_HOSTS=
# Optional fake-IP proxy exception, only for explicitly listed platform/CDN suffixes.
# This permits 198.18.0.0/15 on HTTPS port 443 only; other private addresses stay blocked.
# DM_PUBLIC_PROXY_SUFFIXES=bilibili.com,bilivideo.com,hdslb.com,xiaohongshu.com,xhscdn.com

# Optional third-party reports or webhook Bearer token. Enter this variable name in Settings.
# DM_API_TOKEN_ANALYTICS=
